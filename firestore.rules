rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: wishes
    // Document ID: auto-generated
    // Fields:
    //   - name: string (required, 1-80 chars) - guest display name
    //   - text: string (required, 1-1000 chars) - guestbook message
    //   - createdAt: timestamp (required, server/recent) - when submitted
    // ===============================================================

    function isValidWish(data) {
      return data.keys().hasOnly(['name', 'text', 'createdAt'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.text is string
        && data.text.size() >= 1
        && data.text.size() <= 1000
        && data.createdAt is timestamp
        && data.createdAt <= request.time + duration.value(1, 'm')
        && data.createdAt > request.time - duration.value(5, 'm');
    }

    match /wishes/{wishId} {
      // Public guestbook: guests read & create without auth
      allow read: if true;
      allow create: if isValidWish(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}